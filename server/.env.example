# Copy this file to ".env" and adjust.

PORT=5000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/saffron_menu

# Long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string

# Where the React dev server runs (only used in development for CORS).
CLIENT_ORIGIN=http://localhost:5173

# Push notifications. Optional: without keys, a pair is generated on first use and
# stored in the database. Set VAPID_SUBJECT to a real contact address in production.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Running more than one copy of the server? Set this so live updates reach all of them.
# Needs a MongoDB replica set (Atlas is one). Leave it off for a single server.
# SOCKET_ADAPTER=mongo

# The first admin account, created on first start. Change the password after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
